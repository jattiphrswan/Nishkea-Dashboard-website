# =================================================================
# NISHKÈA — Production Environment Configuration Template
# =================================================================
# Copy this file to .env.local for local development.
# In Vercel / Cloud Hosting: Add these variables under Project Settings > Environment Variables.
# NEVER commit .env.local or real secrets to git.

# -----------------------------------------------------------------
# 1. Cloud PostgreSQL (Neon / Supabase / AWS RDS)
# -----------------------------------------------------------------
# Format for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Format for Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Format for Supabase Pooled: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional max pool connections (defaults to 10)
PG_MAX_CONNECTIONS=

# -----------------------------------------------------------------
# 2. Staff & Client Authentication (Node 3 & Node 11)
# -----------------------------------------------------------------
# Generate a secure 256-bit random key via: openssl rand -hex 32
AUTH_SECRET=

# -----------------------------------------------------------------
# 3. Public Application URL
# -----------------------------------------------------------------
# Local dev: http://localhost:3000
# Production: https://nishkea.com or https://your-project.vercel.app
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------
# 4. Object Storage / Media CDN (S3 Compatible — Node 4)
# -----------------------------------------------------------------
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=

# -----------------------------------------------------------------
# 5. Payment Provider (Razorpay / Stripe — Node 8)
# -----------------------------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# 6. AI Maison Concierge & Operations Copilot (Node 13 & 14)
# -----------------------------------------------------------------
AI_PROVIDER_API_KEY=
AI_MODEL=

# -----------------------------------------------------------------
# 7. Background Workers & Scheduled Review Jobs (Node 5 & 6)
# -----------------------------------------------------------------
JOB_AUTH_SECRET=

# -----------------------------------------------------------------
# 8. Transactional Communications (CRM & Inquiries — Node 10)
# -----------------------------------------------------------------
EMAIL_PROVIDER_KEY=
