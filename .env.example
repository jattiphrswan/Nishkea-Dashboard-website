# NISHKÈA Environment Configuration Template
# Node 2 foundation — Variable names only; no secrets or live credentials.
# Complete system requires adapters configured in subsequent nodes.

# Database (PostgreSQL — Node 3)
DATABASE_URL=

# Authentication (Auth solution / JWT secret — Node 3)
AUTH_SECRET=

# Public Application URL
APP_BASE_URL=http://localhost:3000

# Object Storage / Media CDN (S3 compatible — Node 4)
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=

# Payment Provider (Node 8)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# AI Provider / Model (Node 12)
AI_PROVIDER_API_KEY=
AI_MODEL=

# Background Workers & Scheduled Tasks (Node 5/6)
JOB_AUTH_SECRET=

# Transactional Email / Messaging (Node 10)
EMAIL_PROVIDER_KEY=
